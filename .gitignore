# --- Fichiers dérivés Rodin (régénérés par org.rodinp.core.rodinbuilder) ---
# *.bcm : machine statiquement vérifiée (dérivée de *.bum)
# *.bcc : contexte statiquement vérifié (dérivé de *.buc)
# *.bpo : obligations de preuve générées
*.bcm
*.bcc
*.bpo

# --- Workspace Eclipse / Rodin ---
.metadata/
.settings/
bin/

# --- Exports / archives du workspace ---
# Les sources curées vivent dans model/ ; un export complet rapatrierait les
# fichiers dérivés ignorés plus haut.
*.zip
Export_Rodin_Workspace/

# --- OS ---
.DS_Store
Thumbs.db
