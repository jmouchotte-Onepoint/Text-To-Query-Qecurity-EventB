tors = {EQ}&#10;  @axm_allow_link_types; allow_link_types = {INNER, LEFT, RIGHT}&#10;  @axm_safe_links; fn_safe_links = { (HR↦EMPLOYEES↦DEPARTMENT) ↦ (HR↦DEPARTMENTS↦DEPT_LABEL) }&#10;&#10;  // --- users &amp; metadata tags ---&#10;  @axm_users; partition(USERS, {PAYROLL_MANAGER}, {HR_EMPLOYEE})&#10;  @axm_metadatas; partition(METADATAS, {M_SALES}, {M_ENG}, {M_SALARY})&#10;  @axm_user_meta; fn_query_user_metadatas =&#10;      { PAYROLL_MANAGER ↦ {M_SALES, M_ENG, M_SALARY},&#10;        HR_EMPLOYEE ↦ {M_SALES} }&#10;&#10;  // --- authorization rules: structural scope only, no extra metadata pledge ---&#10;  @axm_authorizations; partition(AUTHORIZATIONS, {AUTH_ALL}, {AUTH_DEPT})&#10;  @axm_scope_all; fn_auth_scope(AUTH_ALL) =&#10;      (allowed_namespaces × allowed_entities × allowed_attributes) × {SELECT}&#10;  @axm_scope_dept; fn_auth_scope(AUTH_DEPT) =&#10;      (allowed_namespaces × allowed_entities × {EMP_NAME, DEPARTMENT, DEPT_LABEL}) × {SELECT}&#10;  @axm_auth_meta; fn_auth_metadatas = {AUTH_ALL ↦ ∅, AUTH_DEPT ↦ ∅} // no extra channel needed here&#10;  @axm_auth_meta_user; fn_auth_metadatas_to_user_metadatas = {AUTH_ALL ↦ ∅, AUTH_DEPT ↦ ∅}&#10;  @axm_auth_meta_cond; fn_auth_metadatas_to_cond_metadatas = {AUTH_ALL ↦ ∅, AUTH_DEPT ↦ ∅}&#10;  @axm_auth_meta_data; fn_auth_metadatas_to_data_metadatas = {AUTH_ALL ↦ ∅, AUTH_DEPT ↦ ∅}&#10;&#10;  // --- the six employees.&lt;column&gt; cells that can appear in a query result ---&#10;  @axm_datas; partition(DATAS, {D_ALICE_NAME}, {D_ALICE_SALARY}, {D_ALICE_DEPT},&#10;                                {D_BOB_NAME}, {D_BOB_SALARY}, {D_BOB_DEPT})&#10;  @axm_set_allowed_data; set_allowed_data = DATAS&#10;  @axm_datas_origin; fn_datas_origin =&#10;      { D_ALICE_NAME ↦ (HR↦EMPLOYEES↦EMP_NAME), D_ALICE_SALARY ↦ (HR↦EMPLOYEES↦SALARY),&#10;        D_ALICE_DEPT ↦ (HR↦EMPLOYEES↦DEPARTMENT),&#10;        D_BOB_NAME ↦ (HR↦EMPLOYEES↦EMP_NAME), D_BOB_SALARY ↦ (HR↦EMPLOYEES↦SALARY),&#10;        D_BOB_DEPT ↦ (HR↦EMPLOYEES↦DEPARTMENT) }&#10;  @axm_datas_meta; fn_datas_metadatas =&#10;      { D_ALICE_NAME ↦ {M_SALES}, D_ALICE_DEPT ↦ {M_SALES}, D_ALICE_SALARY ↦ {M_SALES, M_SALARY},&#10;        D_BOB_NAME ↦ {M_ENG}, D_BOB_DEPT ↦ {M_ENG}, D_BOB_SALARY ↦ {M_ENG, M_SALARY} }&#10;  // the &quot;user&quot; channel is the only one used here: a cell's tags must be a&#10;  // subset of the querying user's own metadata (see README, &quot;How can_access resolves&quot;)&#10;  @axm_datas_meta_user; fn_datas_metadatas_to_user_metadatas = fn_datas_metadatas&#10;  @axm_datas_meta_cond; ∀ d · d ∈ set_allowed_data ⇒ fn_datas_metadatas_to_cond_metadatas(d) = ∅&#10;  @axm_datas_meta_auth; ∀ d · d ∈ set_allowed_data ⇒ fn_datas_metadatas_to_auth_metadatas(d) = ∅&#10;  @axm_mapper_metadata_dpatterns; mapper_metadata_dpatterns = ∅&#10;end" version="3">
